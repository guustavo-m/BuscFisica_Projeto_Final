# Banco local: use DB_USER/DB_HOST/DB_NAME/DB_PASSWORD/DB_PORT.
# Banco gerenciado: prefira DATABASE_URL (URI PostgreSQL).
DATABASE_URL=
DB_USER=postgres
DB_HOST=localhost
DB_NAME=buscfisica
DB_PASSWORD=troque-esta-senha
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Gere um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
